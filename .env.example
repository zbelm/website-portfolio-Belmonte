# Copy this file to `.env` for local development (never commit `.env`).
# On Vercel: Project → Settings → Environment Variables → add the same keys.

# Your Web3Forms access key (free: https://web3forms.com) — or your Formspree form ID.
VITE_FORM_KEY=your-access-key-here

# Optional: "web3forms" (default) or "formspree"
VITE_FORM_PROVIDER=web3forms
